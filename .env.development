# Dev-only: route TSA/certificate requests through the built-in Vite CORS proxy
VITE_CORS_PROXY_URL=/cors-proxy

# WASM Module URLs — 从本地加载，不走 CDN
VITE_WASM_PYMUPDF_URL=/wasm/pymupdf/
VITE_WASM_GS_URL=/wasm/ghostscript/
VITE_WASM_CPDF_URL=/wasm/cpdf/

# Tesseract OCR — 本地化部署
VITE_TESSERACT_WORKER_URL=/wasm/tesseract/worker.min.js
VITE_TESSERACT_CORE_URL=/wasm/tesseract/core/
VITE_TESSERACT_LANG_URL=/wasm/tesseract/lang/

# TuHe PDF branding
VITE_BRAND_NAME=TuHe PDF
VITE_BRAND_LOGO=
VITE_FOOTER_TEXT=© 2026 TuHe PDF
